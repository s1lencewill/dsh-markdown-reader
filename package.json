{
  "name": "@s1lencewill/dsh-markdown-reader",
  "description": "DSH Web GUI 全屏 Markdown 阅读器插件：GFM、KaTeX、Mermaid、目录与阅读进度、外部文件变更同步、图片/代码/表格/长章节增强，以及打印与另存 PDF。工作区门禁的只读路由；零构建、零运行时依赖。",
  "version": "0.4.0",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.cjs",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "vendor",
    "cordis.patch.yml",
    "README.md",
    "README_EN.md",
    "docs/screenshots",
    "LICENSE"
  ],
  "dsh": {
    "engines": {
      "dsh": ">=0.1.7-rc.2"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:print": "node test/print.browser.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/s1lencewill/dsh-markdown-reader.git"
  },
  "homepage": "https://github.com/s1lencewill/dsh-markdown-reader#readme",
  "bugs": {
    "url": "https://github.com/s1lencewill/dsh-markdown-reader/issues"
  },
  "license": "BSD-3-Clause"
}
